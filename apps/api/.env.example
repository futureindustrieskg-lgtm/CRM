# Скопируйте в .env и заполните. Файл .env не попадает в репозиторий.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/crm?schema=public"
PORT=3000
JWT_SECRET="change-me-long-random-string"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
# Токен для входящих заявок с сайта (заголовок X-Webhook-Token)
WEBHOOK_TOKEN="change-me"
# Срок первого касания лида, минут (ТЗ 3.1)
FIRST_CONTACT_MINUTES=15
CORS_ORIGIN="http://localhost:5173"

# ───── Уведомления (ТЗ 3.8, 5) ─────
# Пока провайдер не задан, сообщения проходят «имитацию»: попадают в журнал со статусом simulated.
# NOTIFY_DRY_RUN=0 — отключить имитацию; NOTIFY_SCHEDULER=0 — отключить минутный цикл отправки.
CENTER_NAME=Deutschzentrum
NOTIFY_DRY_RUN=1
# Telegram-бот центра: токен от @BotFather, имя бота, секрет webhook (/api/v1/webhooks/telegram/<секрет>)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Cloud API (Meta Business)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# SMS-шлюз: POST JSON { phone, text }
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# E-mail через HTTP API: POST JSON { from, to, subject, text }
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# ───── Интеграции (ТЗ 5) ─────
# Адреса для ссылок в сообщениях и возврата из банка
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
# Исходящие webhook-и: разрешить адреса во внутренней сети и http (только для разработки!)
WEBHOOK_ALLOW_PRIVATE=0
# Онлайн-занятия: Zoom (Server-to-Server OAuth); без ключей — Jitsi Meet
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=
# Эквайринг / QR банка: универсальный адаптер (см. src/integrations/payments.ts)
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_TOKEN=
PAYMENT_WEBHOOK_SECRET=
# Тестовая оплата без банка (кнопка на странице оплаты) — только для разработки и демонстрации
PAYMENTS_TEST_MODE=0
# Онлайн-касса (ЭКМ): POST JSON чека → { fiscalNumber }; без неё — имитация
FISCAL_API_URL=
FISCAL_API_TOKEN=
