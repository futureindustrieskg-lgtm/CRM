// Модель данных CRM учебного центра немецкого языка.
// Описание сущностей: docs/02-data-model.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Организация ─────────────

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  timezone  String   @default("Asia/Bishkek")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rooms     Room[]
  userRoles UserRole[]
  leads     Lead[]
  students  Student[]
  groups    Group[]
  payments  Payment[]
}

model Room {
  id       String  @id @default(uuid())
  branchId String
  name     String
  capacity Int     @default(10)
  isOnline Boolean @default(false)

  branch  Branch   @relation(fields: [branchId], references: [id])
  groups  Group[]
  lessons Lesson[]
}

// ───────────── Пользователи, роли, права ─────────────

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  firstName       String
  lastName        String
  locale          String    @default("ru") // ru | ky | de | en
  /// Категория преподавателя для расчёта оплаты: new | experienced (ставки — в настройках payroll).
  teacherCategory String    @default("new")
  /// Привязка Telegram-бота центра (уведомления).
  telegramChatId  String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())

  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  managedLeads   Lead[]               @relation("LeadManager")
  tasks          Task[]               @relation("TaskAssignee")
  leadActivities LeadActivity[]
  student        Student?
  parentLinks    ParentStudent[]
  teachingGroups Group[]              @relation("GroupTeacher")
  lessons        Lesson[]             @relation("LessonTeacher")
  notifications  Notification[]
  chatMembers    ConversationMember[]
  chatMessages   ChatMessage[]        @relation("ChatSender")
}

/// Роль — набор прав. Права: "<модуль>.<действие>", например "leads.read", "finance.delete_records".
model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())

  users UserRole[]
}

/// Роль пользователя в филиале. branchId = null — доступ ко всем филиалам.
model UserRole {
  id       String  @id @default(uuid())
  userId   String
  roleId   String
  branchId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, branchId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Журнал действий (ТЗ 2): кто, когда и что изменил. Хранение ≥ 3 лет.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  entity    String
  entityId  String
  action    String // create | update | delete | stage_change | merge
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────── 3.1 Лиды и продажи ─────────────

/// Этап воронки. Этапы настраиваются; isLost — этап «Отказ» с обязательной причиной.
model PipelineStage {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  sort   Int
  color  String  @default("#64748b")
  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  leads Lead[]
}

model Lead {
  id             String    @id @default(uuid())
  branchId       String?
  stageId        String
  managerId      String?
  firstName      String
  lastName       String?
  phone          String?
  email          String?
  source         String    @default("manual") // site | whatsapp | telegram | instagram | call | manual | referral
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  currentLevel   String? // A1 … C2
  targetLevel    String?
  goal           String? // exam | work | study | family | other
  preferredTime  String?
  lostReason     String?
  levelTestScore Int?
  firstContactAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  mergedIntoId   String?

  branch       Branch?        @relation(fields: [branchId], references: [id])
  stage        PipelineStage  @relation(fields: [stageId], references: [id])
  manager      User?          @relation("LeadManager", fields: [managerId], references: [id])
  activities   LeadActivity[]
  tasks        Task[]
  testAttempts TestAttempt[]
  student      Student?

  @@index([phone])
  @@index([email])
  @@index([stageId])
}

/// История коммуникаций: комментарий, звонок, сообщение, смена этапа.
model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  type      String // comment | call | message | stage_change | system
  text      String
  meta      Json?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}

model Task {
  id         String    @id @default(uuid())
  leadId     String?
  assigneeId String
  title      String
  dueAt      DateTime
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  lead     Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User  @relation("TaskAssignee", fields: [assigneeId], references: [id])
}

// ───────────── 3.2 Клиенты и студенты ─────────────

model Student {
  id            String    @id @default(uuid())
  userId        String?   @unique
  leadId        String?   @unique
  branchId      String
  firstName     String
  lastName      String
  birthDate     DateTime?
  phone         String?
  email         String?
  currentLevel  String?
  targetLevel   String?
  goal          String?
  preferredTime String?
  status        String    @default("active") // active | paused | finished | left
  balance       Decimal   @default(0) @db.Decimal(12, 2)
  consentAt     DateTime? // согласие на обработку ПД
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User?                @relation(fields: [userId], references: [id])
  lead          Lead?                @relation(fields: [leadId], references: [id])
  branch        Branch               @relation(fields: [branchId], references: [id])
  parents       ParentStudent[]
  groups        GroupStudent[]
  attendance    Attendance[]
  grades        Grade[]
  payments      Payment[]
  submissions   HomeworkSubmission[]
  subscriptions Subscription[]
  homework      Homework[]           @relation("HomeworkStudent")
  testAttempts  TestAttempt[]

  @@index([branchId, status])
}

/// Связка «родитель — ребёнок»; isPayer — плательщик.
model ParentStudent {
  parentId  String
  studentId String
  isPayer   Boolean @default(true)

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

// ───────────── 3.4 Курсы и группы ─────────────

model Course {
  id            String  @id @default(uuid())
  name          String
  level         String // A1.1 … C2
  format        String // group | individual | mini_group | online
  academicHours Int
  textbook      String?
  price         Decimal @db.Decimal(12, 2)
  isActive      Boolean @default(true)

  groups        Group[]
  topics        CourseTopic[]
  tariffs       Tariff[]
  subscriptions Subscription[]
}

/// Учебный план уровня: темы уроков и главы учебника (ТЗ 3.4).
model CourseTopic {
  id       String  @id @default(uuid())
  courseId String
  sort     Int
  title    String
  chapter  String?

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, sort])
}

model Group {
  id           String    @id @default(uuid())
  branchId     String
  courseId     String
  teacherId    String?
  roomId       String?
  name         String
  minStudents  Int       @default(4)
  maxStudents  Int       @default(12)
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("recruiting") // recruiting | running | finished
  scheduleRule Json? // {"days":[1,3,5],"start":"19:00","end":"20:30"}

  branch        Branch         @relation(fields: [branchId], references: [id])
  course        Course         @relation(fields: [courseId], references: [id])
  teacher       User?          @relation("GroupTeacher", fields: [teacherId], references: [id])
  room          Room?          @relation(fields: [roomId], references: [id])
  students      GroupStudent[]
  lessons       Lesson[]
  homework      Homework[]
  subscriptions Subscription[]
}

model GroupStudent {
  groupId   String
  studentId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  waitlist  Boolean   @default(false)

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
}

// ───────────── 3.3 Расписание, 3.5 Посещаемость ─────────────

model Lesson {
  id        String   @id @default(uuid())
  groupId   String
  teacherId String?
  roomId    String?
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("planned") // planned | done | cancelled | moved
  topic     String?
  onlineUrl String?

  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher       User?        @relation("LessonTeacher", fields: [teacherId], references: [id])
  room          Room?        @relation(fields: [roomId], references: [id])
  attendance    Attendance[]
  grades        Grade[]
  courseTopicId String?
  courseTopic   CourseTopic? @relation(fields: [courseTopicId], references: [id], onDelete: SetNull)

  @@index([startsAt])
}

model Attendance {
  lessonId       String
  studentId      String
  status         String // present | excused | absent | late
  /// Занятие списано с абонемента по правилам центра на момент отметки.
  charged        Boolean  @default(false)
  /// Абонемент, с которого списано занятие; null при списании — занятие в долг.
  subscriptionId String?
  comment        String?
  markedById     String?
  markedAt       DateTime @default(now())

  lesson       Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@id([lessonId, studentId])
  @@index([subscriptionId])
}

/// Оценка по навыкам Goethe: Hören, Lesen, Schreiben, Sprechen.
model Grade {
  id           String   @id @default(uuid())
  studentId    String
  lessonId     String?
  skill        String // hoeren | lesen | schreiben | sprechen | overall
  value        Decimal  @db.Decimal(6, 2)
  scale        String   @default("percent") // points | percent | de_1_6
  /// Максимум для шкалы points (например, 100 баллов за модуль Goethe).
  maxValue     Decimal? @db.Decimal(6, 2)
  comment      String?
  createdById  String?
  /// Оценка за ДЗ — засчитывается в навык задания.
  submissionId String?  @unique
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([studentId, skill])
}

// ───────────── Настройки центра ─────────────

/// Правила центра (списание занятий, шкала оценок, порог пропусков): ключ → JSON.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Очередь уведомлений ─────────────

/// Очередь уведомлений (ТЗ 3.8): по одному сообщению на получателя.
/// Канал выбирается при отправке по приоритету типа сообщения и доступным адресам получателя.
model Notification {
  id             String    @id @default(uuid())
  /// Получатель с учётной записью (push / уведомление в кабинете).
  userId         String?
  studentId      String?
  leadId         String?
  /// Филиал получателя — журнал отправки виден администратору только своего филиала.
  branchId       String?
  /// Адреса на момент постановки в очередь.
  phone          String?
  email          String?
  telegramChatId String?
  locale         String    @default("ru")
  type           String // lesson_reminder | homework_new | grade | payment_received | debt_reminder | …
  title          String
  body           String
  status         String    @default("queued") // queued | sent | failed | skipped
  /// Канал, через который ушло сообщение: push | whatsapp | telegram | sms | email.
  channel        String?
  error          String?
  attempts       Int       @default(0)
  scheduledAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  readAt         DateTime?
  /// Ключ защиты от повторов (например, напоминание об одном занятии одному получателю).
  dedupeKey      String?   @unique
  broadcastId    String?

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId, readAt])
  @@index([branchId, createdAt])
}

/// Шаблон сообщения на языке получателя с подстановкой полей {{name}}, {{date}}, {{amount}}…
model MessageTemplate {
  id        String   @id @default(uuid())
  type      String
  locale    String // ru | ky
  title     String
  body      String
  updatedAt DateTime @updatedAt

  @@unique([type, locale])
}

/// Массовая рассылка по сегменту (ТЗ 3.8).
model Broadcast {
  id          String    @id @default(uuid())
  title       String
  body        String
  /// Фильтр получателей: { branchId, status, level, groupId, finishedLevel, debtOnly, includeParents }
  segment     Json
  total       Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  notifications Notification[]
}

// ───────────── Внутренний чат ─────────────

/// Чат: группы (group), личный «студент — преподаватель» (direct), «клиент — администрация филиала» (support).
model Conversation {
  id            String   @id @default(uuid())
  type          String // group | direct | support
  groupId       String?  @unique
  branchId      String?
  title         String?
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  members  ConversationMember[]
  messages ChatMessage[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  files        StoredFile[]

  @@index([conversationId, createdAt])
}

// ───────────── 3.6 Домашние задания ─────────────

/// Домашнее задание группе или отдельному студенту группы (ТЗ 3.6).
model Homework {
  id          String    @id @default(uuid())
  groupId     String
  /// Индивидуальное ДЗ одному студенту; null — всей группе.
  studentId   String?
  title       String
  description String?
  /// Ссылки: [{ url, title }]
  links       Json?
  /// Навык, в который засчитывается оценка: hoeren | lesen | schreiben | sprechen | overall.
  skill       String?
  /// ДЗ-тест: проверяется автоматически.
  testId      String?
  dueAt       DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student?             @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  test        Test?                @relation(fields: [testId], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]
  files       StoredFile[]         @relation("HomeworkFiles")
}

model HomeworkSubmission {
  id            String    @id @default(uuid())
  homeworkId    String
  studentId     String
  text          String?
  /// Длительность аудиоответа в секундах (Sprechen — до 5 минут).
  audioSeconds  Int?
  submittedAt   DateTime  @default(now())
  status        String    @default("submitted") // submitted | checked | returned
  grade         Decimal?  @db.Decimal(6, 2)
  feedback      String?
  checkedAt     DateTime?
  checkedById   String?
  testAttemptId String?   @unique

  homework    Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testAttempt TestAttempt? @relation(fields: [testAttemptId], references: [id], onDelete: SetNull)
  files       StoredFile[] @relation("SubmissionFiles")

  @@unique([homeworkId, studentId])
}

/// Загруженный файл (фото, документ, аудио). Хранится на диске сервера, доступ — через API с проверкой прав.
model StoredFile {
  id           String   @id @default(uuid())
  ownerId      String?
  name         String
  mime         String
  size         Int
  path         String
  /// Голосовой или файловый ответ преподавателя к сдаче.
  isFeedback   Boolean  @default(false)
  homeworkId   String?
  submissionId String?
  questionId   String?
  messageId    String?
  createdAt    DateTime @default(now())

  homework   Homework?           @relation("HomeworkFiles", fields: [homeworkId], references: [id], onDelete: SetNull)
  submission HomeworkSubmission? @relation("SubmissionFiles", fields: [submissionId], references: [id], onDelete: SetNull)
  question   TestQuestion?       @relation(fields: [questionId], references: [id], onDelete: SetNull)
  message    ChatMessage?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
}

// ───────────── 3.6 Тесты ─────────────

/// Тест: обычный (ДЗ, контрольная) или входной тест уровня (placement) для лидов по ссылке.
model Test {
  id           String   @id @default(uuid())
  title        String
  description  String?
  kind         String   @default("quiz") // quiz | placement
  level        String?
  timeLimitMin Int?
  isPublished  Boolean  @default(false)
  /// Общая ссылка входного теста: /test/<publicToken>
  publicToken  String?  @unique
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions TestQuestion[]
  attempts  TestAttempt[]
  homework  Homework[]
}

model TestQuestion {
  id     String  @id @default(uuid())
  testId String
  sort   Int
  /// choice | article | matching | text
  type   String
  prompt String
  /// Уровень вопроса для входного теста (A1…C1).
  level  String?
  points Int     @default(1)
  /// Варианты и правильные ответы; формат зависит от type (см. tests.ts).
  data   Json

  test  Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  files StoredFile[]

  @@index([testId, sort])
}

/// Попытка прохождения теста: студентом (ДЗ) или лидом (входной тест по ссылке).
model TestAttempt {
  id         String    @id @default(uuid())
  testId     String
  /// Личная ссылка на попытку: /test/a/<token>
  token      String    @unique
  studentId  String?
  leadId     String?
  homeworkId String?
  guestName  String?
  startedAt  DateTime?
  deadlineAt DateTime?
  finishedAt DateTime?
  timedOut   Boolean   @default(false)
  answers    Json?
  score      Decimal?  @db.Decimal(8, 2)
  maxScore   Decimal?  @db.Decimal(8, 2)
  percent    Decimal?  @db.Decimal(5, 2)
  /// Результат входного теста.
  level      String?
  createdAt  DateTime  @default(now())

  test       Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  student    Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  submission HomeworkSubmission?
}

// ───────────── 3.7 Финансы ─────────────

model Payment {
  id             String    @id @default(uuid())
  branchId       String
  studentId      String
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("KGS")
  method         String // cash | transfer | qr | card_online
  /// payment — поступление; refund — возврат (сумма отрицательная).
  type           String    @default("payment")
  subscriptionId String?
  createdById    String?
  comment        String?
  paidAt         DateTime  @default(now())
  deletedAt      DateTime?
  deleteReason   String?

  branch       Branch        @relation(fields: [branchId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([paidAt])
}

/// Прайс-лист: варианты оплаты курса (ТЗ 3.7).
model Tariff {
  id           String  @id @default(uuid())
  courseId     String?
  name         String
  type         String // month | level | package | installment
  lessons      Int
  price        Decimal @db.Decimal(12, 2)
  /// Для рассрочки — на сколько платежей делится сумма.
  installments Int     @default(1)
  isActive     Boolean @default(true)

  course        Course?        @relation(fields: [courseId], references: [id])
  subscriptions Subscription[]
}

/// Абонемент студента: сколько занятий куплено и по какой цене.
/// Продажа абонемента уменьшает баланс студента, оплата — увеличивает.
model Subscription {
  id                 String    @id @default(uuid())
  studentId          String
  branchId           String
  courseId           String
  groupId            String?
  tariffId           String?
  type               String // month | level | package | installment
  lessonsTotal       Int
  basePrice          Decimal   @db.Decimal(12, 2)
  discountPercent    Decimal   @default(0) @db.Decimal(5, 2)
  discountType       String? // family | friend | full_level | promo | other
  promoCode          String?
  /// Итоговая цена после скидки; при расторжении уменьшается до стоимости использованных занятий.
  price              Decimal   @db.Decimal(12, 2)
  installments       Int       @default(1)
  status             String    @default("active") // active | finished | cancelled | transferred
  startDate          DateTime  @default(now())
  closedAt           DateTime?
  closeReason        String?
  /// Абонемент, из остатка которого создан этот (перевод в другую группу).
  fromSubscriptionId String?
  createdById        String?
  createdAt          DateTime  @default(now())

  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id])
  group      Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tariff     Tariff?      @relation(fields: [tariffId], references: [id])
  attendance Attendance[]
  payments   Payment[]

  @@index([studentId, status])
}
