{
  "expo": {
    "name": "Deutschzentrum",
    "slug": "deutschzentrum-crm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deutschzentrum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.deutschzentrum.crm"
    },
    "android": {
      "package": "kg.deutschzentrum.crm",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1d4ed8"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1",
      "eas": {
        "projectId": ""
      }
    }
  }
}
