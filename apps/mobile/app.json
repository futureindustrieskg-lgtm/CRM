{
  "expo": {
    "name": "Deutschzentrum",
    "slug": "deutschzentrum-crm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "deutschzentrum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.deutschzentrum.crm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kg.deutschzentrum.crm",
      "permissions": ["POST_NOTIFICATIONS", "CAMERA", "RECORD_AUDIO"],
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1d4ed8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы прикрепить фото тетради к домашнему заданию.",
          "cameraPermission": "Приложению нужна камера, чтобы сфотографировать тетрадь для домашнего задания."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Приложению нужен микрофон, чтобы записать устный ответ (Sprechen) к домашнему заданию."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1",
      "eas": {
        "projectId": ""
      }
    }
  }
}
